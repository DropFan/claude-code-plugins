{
  "description": "Evaluate conversation for extractable patterns when session ends. Rename to hooks.json to enable.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "If this conversation contains reusable patterns (workflow, methodology, strategy) worth extracting as a Skill/Command/Agent, block and suggest `/skill-extractor:extract`. Otherwise approve silently."
          }
        ]
      }
    ]
  }
}