{
  "description": "Optional: Suggest saving the conversation when the session ends. Disabled by default — rename to hooks.json to enable. Respects stop_hook / stop_hook_threshold in .claude/chat-saver.local.md.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh"
          }
        ]
      }
    ]
  }
}
